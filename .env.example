# Absolute origin the boards are served from. Canonical links, the social image,
# robots.txt and sitemap.xml need it, and so does the QR code a phone scans,
# which has to point at an address that phone can reach. Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra RTCIceServer entries, as a JSON array, added to the built-in STUN
# servers. A TURN relay belongs here: without one, boards between two browser
# engines or behind strict NATs never connect. Read at build time, and compiled
# into the client bundle, so anyone loading the page can read these credentials.
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]'
